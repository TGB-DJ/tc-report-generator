rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get the requesting user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isHod() {
      return request.auth != null && getUserRole() == 'hod';
    }

    function isTeacher() {
      return request.auth != null && getUserRole() == 'teacher';
    }

    function isStudent() {
      return request.auth != null && getUserRole() == 'student';
    }

    // Users collection
    match /users/{userId} {
      // Allow read if:
      // 1. Authenticated and it's their own UID
      // 2. Admin/HOD
      // 3. The email matches their verified auth email (needed for migration)
      // 4. It's a student (public read for verification)
      allow read: if (request.auth != null && (
                    request.auth.uid == userId || 
                    isAdmin() || 
                    isHod() || 
                    request.auth.token.email == resource.data.email
                  )) || resource.data.role == 'student';
                  
      // Allow write/delete if:
      // 1. Admin
      // 2. It's their own UID
      // 3. The document's email matches their verified auth email (enables migration)
      allow write, delete: if request.auth != null && (
        isAdmin() || 
        request.auth.uid == userId || 
        request.auth.token.email == resource.data.email ||
        (request.resource != null && request.auth.token.email == request.resource.data.email)
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == adminId || 
          request.auth.token.email == resource.data.email ||
          (request.resource != null && request.auth.token.email == request.resource.data.email)
        )
      );
    }

    // Teachers collection
    match /teachers/{teacherId} {
      // Admins and HODs can read all; teachers can read their own
      allow read: if request.auth != null &&
        (request.auth.uid == teacherId || isAdmin() || isHod() || request.auth.token.email == resource.data.email);
      // Only admins can write, OR the teacher themselves can move/update if email matches
      allow write, delete: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == teacherId || 
          request.auth.token.email == resource.data.email ||
          (request.resource != null && request.auth.token.email == request.resource.data.email)
        )
      );
    }

    // Helper: get teacher department
    function getTeacherDept() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.dept;
    }

    // Students collection
    match /students/{studentId} {
      // Allow public read for ID card verification (get by specific ID)
      allow get: if true;
      // Restrict listing (queries)
      allow list: if isAdmin() || isHod() || (isTeacher() && (
        // Check if student dept contains the teacher's core department name
        resource.data.dept.upper().matches('.*' + getTeacherDept().upper().replace('\\(', '').replace('\\)', '') + '.*')
      ));

      // Only admins can write, OR the student themselves can move/update if email matches
      allow write, delete: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == studentId || 
          request.auth.token.email == resource.data.email ||
          (request.resource != null && request.auth.token.email == request.resource.data.email)
        )
      );
    }

    // Attendance collection
    match /attendance/{recordId} {
      // Allow read/write for Admins/HODs or Teachers in the same department
      allow read: if isAdmin() || isHod() || (isTeacher() && (
        resource.data.dept.upper().matches('.*' + getTeacherDept().upper().replace('\\(', '').replace('\\)', '') + '.*')
      ));
      allow create: if isAdmin() || isHod() || (isTeacher() && (
        request.resource.data.dept.upper().matches('.*' + getTeacherDept().upper().replace('\\(', '').replace('\\)', '') + '.*')
      ));
      allow update, delete: if isAdmin() || isHod();
    }

    // Events collection
    match /events/{eventId} {
      // All authenticated users can read events
      allow read: if request.auth != null;
      // Only admins can create/update/delete events
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
