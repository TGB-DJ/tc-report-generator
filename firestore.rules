rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get the requesting user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isHod() {
      return request.auth != null && getUserRole() == 'hod';
    }

    function isTeacher() {
      return request.auth != null && getUserRole() == 'teacher';
    }

    function isStudent() {
      return request.auth != null && getUserRole() == 'student';
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own doc; admins/HODs can read all.
      // Allow public read IF the document is a student (needed for public ID Card verification)
      allow read: if (request.auth != null && (request.auth.uid == userId || isAdmin() || isHod()))
                  || resource.data.role == 'student';
      // Only the user themselves or admins can write
      allow write: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
    }

    // Admins collection - only admins can read/write
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Teachers collection
    match /teachers/{teacherId} {
      // Admins and HODs can read all; teachers can read their own
      allow read: if request.auth != null &&
        (request.auth.uid == teacherId || isAdmin() || isHod());
      // Only admins can create/update/delete
      allow write: if isAdmin();
    }

    // Students collection
    match /students/{studentId} {
      // Allow public read for ID card verification
      allow read: if true;
      // Only admins can create/update/delete
      allow write: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      // All authenticated users can read events
      allow read: if request.auth != null;
      // Only admins can create/update/delete events
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
